    "chartjs-node-canvas": "^5.0.0",
    "colorthief": "^3.4.0",
    "discord.js": "^14.26.4",
    "enhanced-ms": "^5.0.0",
    "mathjs": "^15.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.6.0",
    "eslint-plugin-unicorn": "^71.1.0",
    "prettier": "^3.9.4",
    "typescript": "^7.0.1-rc",
    "typescript-eslint": "^8.63.0"
